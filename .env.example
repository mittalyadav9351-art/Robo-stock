# Robotics Club Component Management System Configuration

# Set your MongoDB Atlas connection string here:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/robo_stock?retryWrites=true&w=majority
MONGODB_URI=

# Server Port
PORT=5000

# JWT Security Secret
JWT_SECRET=robotics_club_super_secure_jwt_key_2026_production

# Frontend Client Port (default 5173 for Vite)
FRONTEND_PORT=5173

# Allowed CORS origins in production (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Set to false in production to disable 1-click demo role switcher
ENABLE_DEMO_AUTH=true
